{
  "name": "@invest/core",
  "version": "0.1.0",
  "private": true,
  "description": "指標・シグナル・スコア・バックテスト。依存ゼロの純TypeScript",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./indicators": "./src/indicators/index.ts",
    "./signals": "./src/signals/index.ts",
    "./scoring": "./src/scoring/index.ts",
    "./market": "./src/market/index.ts",
    "./backtest": "./src/backtest/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:test": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=.build/core.mjs",
    "test": "npm run build:test && node --test test/*.test.mjs"
  }
}
